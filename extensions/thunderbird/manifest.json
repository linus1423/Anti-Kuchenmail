{
  "manifest_version": 2,
  "name": "Kuchenmail-Guard",
  "description": "Hält Kuchenmails beim Senden an und gibt sie nur mit dem Passwort des Rechners frei.",
  "version": "0.1.0",
  "author": "Linus",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird@kuchenmail-guard",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["compose", "nativeMessaging", "notifications"],
  "background": {
    "scripts": ["native.js", "background.js"]
  }
}
