{
  "manifest_version": 2,
  "name": "Kuchenmail-Guard Spike (Webmail)",
  "version": "0.0.1",
  "browser_specific_settings": {
    "gecko": { "id": "spike-webmail@kuchenmail-guard", "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] } }
  },
  "permissions": ["nativeMessaging", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["probe.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
